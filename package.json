{
  "name": "noewbar-cs-pro",
  "version": "1.0.0",
  "private": true,
  "description": "Noewbar CS Pro - Multi-tenant SaaS WhatsApp Customer Service automation platform",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "next dev -p 3001",
    "build": "next build && npm run copy:static",
    "copy:static": "mkdir -p .next/standalone/public && cp -R public/. .next/standalone/public/ 2>/dev/null; cp -R .next/static .next/standalone/.next/static",
    "start": "node --env-file-if-exists=.env .next/standalone/server.js",
    "start:next": "next start -p 3001",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:push": "prisma db push",
    "gates": "tsx scripts/gates.ts",
    "scheduler": "tsx scripts/scheduler.ts",
    "smoke": "node scripts/smoke-test.mjs",
    "sse:verify": "node scripts/sse-verify.mjs",
    "artifacts:verify": "tsx scripts/artifact-verify.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@node-rs/argon2": "^2.2.2",
    "@prisma/client": "5.22.0",
    "bullmq": "^5.34.0",
    "ioredis": "^5.4.2",
    "lucide-react": "^0.468.0",
    "next": "14.2.35",
    "openai": "^4.77.0",
    "pdfkit": "^0.20.2",
    "pg": "^8.13.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.10",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "autoprefixer": "^10.4.20",
    "eslint": "^8.57.1",
    "eslint-config-next": "14.2.35",
    "postcss": "^8.4.49",
    "prisma": "5.22.0",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
