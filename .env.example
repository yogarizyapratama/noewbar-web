# NOEWBAR CS PRO — Environment Template
# Copy to .env and fill with real credentials. Never commit .env.
#
# REQUIRED (no default, the app refuses to start without them):
#   DATABASE_URL, MINIO_ACCESS_KEY, MINIO_SECRET_KEY,
#   WHATSMEOW_SECRET (min 1 char), NEXTAUTH_SECRET (min 32 chars)
# These are credentials. They are deliberately NOT defaulted in src/lib/env.ts so a
# misconfigured deployment fails closed instead of using a value published here.

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/noewbar_pro_db?schema=public"

MINIO_ENDPOINT=""
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""
MINIO_BUCKET="noewbar-assets"
MINIO_PUBLIC_URL=""

AI_GATEWAY_URL=""
OPENAI_BASE_URL=""
AI_MODEL="combo-ai"
AI_API_KEY=""
OPENAI_API_KEY=""
# Fallback models (comma-separated) tried when the primary returns empty output.
AI_FALLBACK_MODELS="combo-free"
# How many past chat messages are replayed as context. 12 (~6 exchanges) covers
# a full inquiry -> order flow. Quality knob, not a cost knob (each message is
# ~27 tokens; the whole history is ~7% of a reply's input tokens).
AI_MAX_HISTORY_MESSAGES="12"

WHATSMEOW_URL="http://127.0.0.1:8088"
WHATSMEOW_DAEMON_URL="http://127.0.0.1:8088"
WHATSMEOW_SECRET=""

TELEGRAM_BOT_TOKEN=""
TELEGRAM_ADMIN_CHAT_ID=""

MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION="false"
MIDTRANS_NOTIFICATION_URL="http://localhost:3001/api/billing/webhook"

REDIS_URL="redis://127.0.0.1:6379"

NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3001"
NEXT_PUBLIC_APP_URL="http://localhost:3001"
NEXT_PUBLIC_APP_NAME="Noewbar CS Pro"
PORT=3001

SUPERADMIN_EMAIL=""
SUPERADMIN_PASSWORD_HASH=""
